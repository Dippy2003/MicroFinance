# Copy to backend/.env and fill in. backend/.env is gitignored.

# --- Groq (free tier) ---
# Get a key at https://console.groq.com (no credit card required).
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=llama-3.3-70b-versatile

# --- Free-tier protection ---
AGENT_REQUEST_LIMIT=3
MAX_EVALUATOR_LOOPS=2

# --- Supabase pgvector (Stage 6) ---
SUPABASE_URL=
# Use the service role key
SUPABASE_KEY=
RAG_DEFAULT_K=5
